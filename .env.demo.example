# Copy to .env.demo (ignored by Git) and fill in. Never commit real values.
# The domain whose DNS A record points to this server; Caddy obtains the certificate for it.
DEMO_DOMAIN=
POSTGRES_PASSWORD=
SAMSKA_ADMIN_EMAIL=
# At least 12 characters; the production profile refuses a shorter one.
SAMSKA_ADMIN_PASSWORD=
# Access mode: "private" puts the whole site behind a password (default); "public" opens it as the demo.
DEMO_ACCESS=private
# Private mode: the username and a bcrypt hash made with
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# Keep the hash in single quotes. Never write the plain password here.
DEMO_ACCESS_USER=visitor
DEMO_ACCESS_HASH=
# Public mode: true only changes some wording in the web. Nothing is ever reset automatically.
SAMSKA_DEMO_ENABLED=false
