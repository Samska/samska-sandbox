# Copy to .env.demo (ignored by Git) and fill in. Never commit real values.
POSTGRES_PASSWORD=
SAMSKA_ADMIN_EMAIL=
# At least 12 characters; the production profile refuses a shorter one.
SAMSKA_ADMIN_PASSWORD=
# Optional Spring cron (seconds first), for example "0 0 4 * * *" for a reset every day at 04:00. "-" disables.
SAMSKA_DEMO_RESET_CRON=-
# Bind to 0.0.0.0 only behind a TLS-terminating proxy you control.
DEMO_BIND_ADDRESS=127.0.0.1
DEMO_PORT=8080
