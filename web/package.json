{
  "name": "samska-sandbox-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "vite build",
    "preview": "vite preview",
    "dev:rebuild": "vite --config vite.rebuild.config.ts",
    "start:rebuild": "node ../scripts/rebuild.mjs",
    "typecheck:rebuild": "tsc -p tsconfig.rebuild.json && tsc -p tsconfig.rebuild-e2e.json",
    "test:rebuild": "vitest run --config vite.rebuild.config.ts",
    "build:rebuild": "vite build --config vite.rebuild.config.ts",
    "test:e2e:rebuild": "playwright test --config playwright.rebuild.config.ts",
    "test:lifecycle:rebuild": "node --test ../scripts/rebuild.test.mjs",
    "a11y:contrast:rebuild": "node ../scripts/contrast-check.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
