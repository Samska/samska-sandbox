# Automatic HTTPS (Let's Encrypt) for the domain in DEMO_DOMAIN. Caddy sets X-Forwarded-For and
# X-Forwarded-Proto for the web container, replacing any value a visitor sent.
{$DEMO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy web:8080
}
